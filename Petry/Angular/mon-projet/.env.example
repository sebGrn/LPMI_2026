# Copier ce fichier en .env. Aucun secret n’est nécessaire en local.
WEB_BIND=127.0.0.1
WEB_PORT=8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
OLLAMA_MODEL=qwen3:4b-instruct
IMAGE_TAG=local

# Option NVIDIA après installation de NVIDIA Container Toolkit :
# COMPOSE_FILE=compose.yaml:compose.gpu.yaml

# Déploiement public HTTPS uniquement : décommenter et adapter.
# SITE_DOMAIN=crypto.exemple.fr
# BASIC_AUTH_USER=tracker
# Générer le hash avec la commande du guide. Garder les quotes simples :
# BASIC_AUTH_HASH='$2a$...'
